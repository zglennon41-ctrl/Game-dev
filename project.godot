; WILDLINE — Godot 4.3 project. Open this file in Godot and press Play (F5).
config_version=5

[application]

config/name="WILDLINE"
config/description="The pulse room: an Anchor, a cut-wolf, the beat."
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Data="*res://game/scripts/data.gd"
Settings="*res://game/scripts/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=true

