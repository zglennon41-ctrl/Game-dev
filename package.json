{
  "name": "wildline",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "sim": "tsx src/sim/cli.ts",
    "validate": "tsx src/data/validate-cli.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"require('fs').writeFileSync('node_modules/.gdignore','')\"",
    "test:game": "godot --headless --path . res://game/tests/tests.tscn",
    "balance:game": "godot --headless --path . res://game/tests/balance.tscn"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
