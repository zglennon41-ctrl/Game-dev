{
  "$comment": "How the Reading scores the lattice. Every number here is a designer knob. A form's score = sum over Tally lines of weight x emphasis x sum over keys of (share of that key in the line) x (lean of that key toward the form's Expression + leans toward each of its features). Order of weight follows the Guide: intention, then range and families, then company and ground, then orders, then bonds, then blood.",
  "weights": {
    "intention": 1.0,
    "range": 0.8,
    "families": 0.8,
    "company": 0.5,
    "ground": 0.5,
    "discipline": 0.45,
    "orders": 0.4,
    "bonds": 0.3,
    "blood": 0.2,
    "seed": 0.15,
    "shape": 0.1
  },
  "firstFormWeights": { "seed": 1.0, "blood": 1.0, "shape": 0.6 },
  "emphasis": {
    "$comment": "How much evidence a line needs before it counts in full. A line with less activity than its reference counts in proportion. Intention counts half the moment a Pattern exists, the rest by fires.",
    "reference": { "range": 20, "families": 20, "company": 10, "ground": 10, "discipline": 10, "orders": 20, "bonds": 1 },
    "intentionBase": 0.5,
    "intentionFires": 100
  },
  "diversity": {
    "$comment": "After the best fit is picked, each later pick's score is multiplied by this for each candidate of the same Expression already picked, so three bodies are offered, not three of one kind.",
    "sameExpression": 0.8
  },
  "crossing": {
    "$comment": "A Reading can cross Expressions when at least this many of the top three lines point away from the current kind; otherwise the current kind keeps a bonus.",
    "linesAway": 2,
    "stayBonus": 0.25
  },
  "heritage": {
    "$comment": "Heritage is chosen from the old form's features and adaptations by how well each fits the Tally; a feature the candidate already shares scores this bonus.",
    "sharedBonus": 0.5,
    "minScore": 0.05
  },
