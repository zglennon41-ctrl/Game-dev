{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crises",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "season",
      "phases",
      "weights",
      "ledgers",
      "default",
      "notices",
      "crisisQuests",
      "endings"
    ],
    "properties": {
      "ledgers": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "name",
            "serves",
            "text"
          ]
        }
      },
      "endings": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "title",
            "text",
            "world",
            "chronicle"
          ]
        }
      },
      "crisisQuests": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "zone",
            "ledger",
            "title",
            "posting"
          ]
        }
      }
    }
  }
}
