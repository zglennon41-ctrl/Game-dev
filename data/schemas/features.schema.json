{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "features",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "slot": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "bonus": {
        "type": "object"
      },
      "fixable": {
        "type": "boolean"
      },
      "adaptation": {
        "type": "boolean"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "id",
      "slot",
      "label",
      "bonus"
    ],
    "additionalProperties": false
  }
}
