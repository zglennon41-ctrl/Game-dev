{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adaptations",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "metric": {
        "type": "string"
      },
      "threshold": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "id",
      "metric",
      "threshold"
    ],
    "additionalProperties": false
  }
}
