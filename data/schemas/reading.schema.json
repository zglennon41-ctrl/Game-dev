{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reading",
  "type": "object",
  "required": [
    "weights",
    "firstFormWeights",
    "emphasis",
    "diversity",
    "crossing",
    "heritage",
    "leans",
    "home"
  ],
  "properties": {
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "firstFormWeights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "leans": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "beast",
                  "kith",
                  "engine",
                  "relic",
                  "daemon",
                  "aspect"
                ]
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "features": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "expression",
            "features"
          ],
          "additionalProperties": false
        }
      }
    },
    "home": {
      "type": "object",
      "required": [
        "bonus",
        "floor",
        "away",
        "most",
        "open"
      ],
      "properties": {
        "bonus": {
          "type": "number",
          "minimum": 0
        },
        "floor": {
          "type": "number",
          "minimum": 0
        },
        "away": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "most": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
