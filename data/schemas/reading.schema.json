{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reading",
  "type": "object",
  "required": [
    "rite",
    "refine",
    "words"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "rite": {
      "type": "object",
      "required": [
        "weights",
        "sameClass"
      ],
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "required": [
            "seed",
            "blood",
            "shape"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "sameClass": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "refine": {
      "type": "object",
      "required": [
        "weights",
        "reference",
        "patternFires"
      ],
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "patternFires": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "words": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    }
  }
}
