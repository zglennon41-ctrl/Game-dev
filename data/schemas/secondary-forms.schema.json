{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "secondary-forms",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "does": {
        "type": "string"
      },
      "requires": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "rank",
                "expression",
                "counter",
                "patternFamily",
                "instar",
                "accord"
              ]
            }
          }
        }
      }
    },
    "required": [
      "id",
      "name",
      "does",
      "requires"
    ],
    "additionalProperties": false
  }
}
