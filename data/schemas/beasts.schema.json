{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "beasts",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "shape",
      "molt",
      "health",
      "radius",
      "walkSpeed",
      "gallopSpeed",
      "circleRadius",
      "prowl",
      "attacks",
      "flinchEvery",
      "flinchTime",
      "respawnSeconds"
    ],
    "properties": {
      "shape": {
        "enum": [
          "anchor",
          "turn",
          "cast",
          "read",
          "bind",
          "make"
        ]
      },
      "molt": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "health": {
        "type": "number"
      },
      "attacks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "range",
            "windup",
            "active",
            "recover",
            "damage"
          ]
        }
      }
    }
  }
}
