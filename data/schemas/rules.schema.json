{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rules",
  "type": "object",
  "required": [
    "field",
    "combat",
    "pattern",
    "tiers",
    "verses",
    "resonance",
    "instars",
    "accord",
    "genius",
    "grades",
    "marks",
    "founding",
    "calendar"
  ],
  "properties": {
    "motion": {
      "type": "object",
      "required": [
        "runAbove",
        "rateLimits",
        "strides"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "runAbove": {
          "type": "number",
          "minimum": 0
        },
        "rateLimits": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0.1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "strides": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "armsDown": {
          "type": "object",
          "required": [
            "degrees",
            "clips"
          ],
          "additionalProperties": false,
          "properties": {
            "degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "clips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
