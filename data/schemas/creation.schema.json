{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "creation",
  "type": "object",
  "required": [
    "questions",
    "models",
    "bodies",
    "names",
    "look",
    "stage"
  ],
  "properties": {
    "look": {
      "type": "object",
      "required": [
        "hair",
        "beards",
        "hairColors",
        "skinTones",
        "builds",
        "sexes",
        "statures",
        "capeColors"
      ],
      "properties": {
        "hair": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "beards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "hairColors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "statures": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0.8,
            "maximum": 1.25
          }
        },
        "skinTones": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "builds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "sexes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capeColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "start": {
          "type": "object",
          "required": [
            "hair",
            "hairColors",
            "build",
            "stature"
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "name",
        "size",
        "doors",
        "spawn",
        "style",
        "frames"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "spawn": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "doors": {
          "type": "array",
          "maxItems": 0
        },
        "style": {
          "type": "object",
          "required": [
            "kind",
            "floor"
          ]
        },
        "furniture": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "piece",
              "at"
            ]
          }
        },
        "lights": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "from",
              "color",
              "energy"
            ],
            "properties": {
              "from": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "energy": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "frames": {
          "type": "object",
          "required": [
            "wide",
            "full",
            "half",
            "face"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "dist",
              "look"
            ],
            "properties": {
              "dist": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "look": {
                "type": "number"
              },
              "rise": {
                "type": "number"
              },
              "head": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
