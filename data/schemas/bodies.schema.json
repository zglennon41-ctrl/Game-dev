{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bodies",
  "type": "object",
  "required": [
    "homes"
  ],
  "properties": {
    "homes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "brief",
          "palette",
          "form"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "form": {
            "type": "object",
            "required": [
              "ancestry",
              "details"
            ],
            "additionalProperties": false,
            "properties": {
              "ancestry": {
                "type": "object",
                "required": [
                  "african",
                  "asian",
                  "caucasian"
                ],
                "additionalProperties": false,
                "properties": {
                  "african": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "asian": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "caucasian": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.5,
                  "maximum": 1.5
                }
              },
              "m": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.5,
                  "maximum": 1.5
                }
              },
              "f": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.5,
                  "maximum": 1.5
                }
              }
            }
          },
          "eyes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hairColors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hair": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "faces": {
      "type": "object",
      "required": [
        "presets",
        "sliders"
      ],
      "additionalProperties": false,
      "properties": {
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "details"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "age": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              },
              "m": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              },
              "f": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              }
            }
          },
          "minItems": 6
        },
        "sliders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "details"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "age": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              },
              "m": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              },
              "f": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": -1.6,
                  "maximum": 1.6
                }
              }
            }
          }
        }
      }
    }
  }
}
