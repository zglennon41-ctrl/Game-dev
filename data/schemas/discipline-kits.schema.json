{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "discipline-kits",
  "type": "object",
  "required": [
    "aeronaut",
    "archivist",
    "ascetic",
    "blade",
    "engineer",
    "examiner",
    "geometer",
    "grower",
    "legionary",
    "marshal",
    "pilot",
    "rider"
  ],
  "additionalProperties": {
    "anyOf": [
      {
        "type": "string"
      },
      {
        "type": "object",
        "required": [
          "name",
          "city",
          "techniques",
          "studentAttacks"
        ],
        "properties": {
          "techniques": {
            "type": "array",
            "minItems": 3,
            "maxItems": 9,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "effect",
                "will",
                "cooldown",
                "startup",
                "active",
                "recovery",
                "anim",
                "text"
              ]
            }
          }
        }
      }
    ]
  }
}
