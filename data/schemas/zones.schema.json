{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zones",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "line",
      "colour",
      "ground",
      "night",
      "light",
      "tiles",
      "beasts",
      "areas",
      "extraction"
    ],
    "properties": {
      "colour": {
        "enum": [
          "green",
          "amber",
          "red",
          "black"
        ]
      },
      "light": {
        "type": "object",
        "required": [
          "sky",
          "ambient",
          "ambientEnergy",
          "fog",
          "moon"
        ]
      },
      "tiles": {
        "type": "object",
        "required": [
          "floor",
          "edge",
          "props"
        ],
        "properties": {
          "floor": {
            "type": "array",
            "minItems": 1
          },
          "edge": {
            "type": "array",
            "minItems": 1
          },
          "props": {
            "type": "array"
          }
        }
      },
      "beasts": {
        "type": "object",
        "required": [
          "common",
          "elite"
        ],
        "properties": {
          "named": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "beast",
                "name"
              ]
            }
          }
        }
      },
      "areas": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "size",
            "spawn",
            "doors"
          ],
          "properties": {
            "size": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            },
            "doors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "to",
                  "at",
                  "label"
                ]
              }
            },
            "pack": {
              "type": "object",
              "required": [
                "min",
                "max"
              ]
            }
          }
        }
      }
    }
  }
}
