{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "genius-looks",
  "type": "object",
  "required": ["born", "eyes", "instarGlow", "proportions", "keepsakes", "keepsakeColors", "palettes", "bodies", "forms"],
  "additionalProperties": false,
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
  },
  "properties": {
    "$comment": { "type": "string" },
    "born": {
      "type": "object", "required": ["coatsOffered", "markChance", "marksMax"], "additionalProperties": false,
      "properties": { "coatsOffered": { "type": "integer", "minimum": 1, "maximum": 6 }, "markChance": { "type": "number", "minimum": 0, "maximum": 1 }, "marksMax": { "type": "integer", "minimum": 0 } }
    },
    "eyes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "name", "energy"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" }, "energy": { "type": "number", "minimum": 0.1, "maximum": 3 }, "pulse": { "type": "number", "minimum": 0, "maximum": 1 }, "rate": { "type": "number", "minimum": 0 } } }
    },
    "instarGlow": { "type": "object", "required": ["1", "2", "3", "4", "5", "6"], "additionalProperties": { "type": "number", "minimum": 0.1, "maximum": 4 } },
    "proportions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "low", "high", "shapes", "scale", "words"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/definitions/id" }, "low": { "type": "string" }, "high": { "type": "string" },
          "shapes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "scale": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -0.3, "maximum": 0.3 } },
          "words": { "type": "number", "minimum": 0, "maximum": 1 } } }
    },
    "keepsakes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "name", "sockets", "text"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" }, "text": { "type": "string" },
          "sockets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^socket_" } } } }
    },
    "keepsakeColors": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "name", "color"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" }, "color": { "$ref": "#/definitions/hex" } } }
    },
    "palettes": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 3,
        "items": { "type": "object", "required": ["id", "name", "main", "under", "trim", "mark"], "additionalProperties": false,
          "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" }, "main": { "$ref": "#/definitions/hex" }, "under": { "$ref": "#/definitions/hex" }, "trim": { "$ref": "#/definitions/hex" }, "mark": { "$ref": "#/definitions/hex" } } } }
    },
    "bodies": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["coats", "roles"], "additionalProperties": false,
        "properties": {
          "coats": { "type": "string" },
          "roles": { "type": "object", "additionalProperties": { "enum": ["main", "under", "trim"] } },
          "marks": { "type": "object", "propertyNames": { "pattern": "^[a-z]+$" },
            "additionalProperties": { "type": "object", "required": ["name", "on"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "on": { "enum": ["main", "under", "trim"] } } } },
          "shapes": { "type": "array", "items": { "type": "string" } } } }
    },
    "forms": { "type": "object", "additionalProperties": { "type": "object", "required": ["coats"], "additionalProperties": false, "properties": { "coats": { "type": "string" } } } }
  }
}
