{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "quests",
  "type": "object",
  "required": [
    "perDay",
    "posterNames",
    "types",
    "lines"
  ],
  "properties": {
    "perDay": {
      "type": "object",
      "required": [
        "min",
        "max"
      ]
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "poster",
          "weight",
          "minColour",
          "title",
          "posting",
          "pay",
          "witness",
          "steps",
          "writeup",
          "failed"
        ],
        "properties": {
          "minColour": {
            "enum": [
              "green",
              "amber",
              "red",
              "black"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "goal"
              ]
            }
          }
        }
      }
    }
  }
}
