{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "seeds",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "text": {
        "type": "string"
      },
      "seedMark": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "leansToward": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "text",
      "seedMark",
      "leansToward"
    ],
    "additionalProperties": false
  }
}
