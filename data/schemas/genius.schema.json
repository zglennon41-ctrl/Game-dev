{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "genius",
  "type": "object",
  "required": [
    "orders",
    "byResonance",
    "byExpression",
    "will",
    "fall",
    "witness",
    "tally",
    "size",
    "fight",
    "equipment"
  ],
  "properties": {
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "fromInstar",
          "text"
        ]
      }
    },
    "fight": {
      "type": "object",
      "description": "How a genius fights as what it is (docs/genius-combat.md).",
      "required": [
        "speed",
        "moves",
        "byKind",
        "byExpression",
        "byFeature",
        "ages",
        "great"
      ],
      "properties": {
        "moves": {
          "type": "object"
        },
        "byKind": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "byExpression": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "byFeature": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "ages": {
          "type": "object",
          "required": [
            "young",
            "half-grown",
            "grown",
            "prime",
            "great",
            "apex"
          ]
        },
        "great": {
          "type": "object",
          "required": [
            "wait",
            "will",
            "byKind"
          ]
        }
      }
    },
    "equipment": {
      "type": "object",
      "description": "The equipment geniuses: the three categories, and the size of a held one (docs/genius-types.md).",
      "required": [
        "categories",
        "tolerance",
        "afloat",
        "hand"
      ],
      "properties": {
        "categories": {
          "type": "object",
          "required": [
            "arms",
            "regalia",
            "augments"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "one",
              "text",
              "bases"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "one": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 10
              },
              "bases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "afloat": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hand": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "long",
              "measure",
              "most"
            ],
            "additionalProperties": false,
            "properties": {
              "long": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "measure": {
                "type": "string",
                "enum": [
                  "box",
                  "bulk"
                ]
              },
              "most": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "augments": {
          "type": "object"
        }
      }
    }
  }
}
