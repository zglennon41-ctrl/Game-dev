{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "roster",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "shape": {
        "enum": [
          "anchor",
          "turn",
          "cast",
          "read",
          "bind",
          "make"
        ]
      },
      "genius": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "expression": {
            "enum": [
              "beast",
              "kith",
              "engine",
              "relic",
              "daemon",
              "aspect"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinFeature": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "form",
          "expression",
          "features",
          "kinFeature"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "shape",
      "genius"
    ],
    "additionalProperties": true
  }
}
