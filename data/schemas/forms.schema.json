{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "forms",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "expression": {
        "enum": [
          "beast",
          "kith",
          "engine",
          "relic",
          "daemon",
          "aspect"
        ]
      },
      "silhouette": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "features": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "instars": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      },
      "ages": {
        "type": "object",
        "description": "What the form is called while it is young: a name for an instar (\"1\", \"2\") at which it is not yet grown.",
        "additionalProperties": {
          "type": "string"
        },
        "propertyNames": {
          "pattern": "^[1-6]$"
        }
      },
      "growsInto": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "The elder of its kind: the form a genius that keeps its kind becomes once it has outgrown this one."
      },
      "home": {
        "type": "string",
        "pattern": "^[a-z]+$",
        "description": "The home whose kind this is (a home of data/bodies.json): offered more often to a character who grew up there, and only at the rite."
      }
    },
    "required": [
      "id",
      "name",
      "expression",
      "silhouette",
      "features",
      "instars"
    ],
    "additionalProperties": false
  }
}
