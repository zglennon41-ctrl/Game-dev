{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "forms",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "expression": {
        "enum": [
          "beast",
          "kith",
          "engine",
          "relic",
          "daemon",
          "aspect"
        ]
      },
      "silhouette": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "features": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "instars": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "expression",
      "silhouette",
      "features",
      "instars"
    ],
    "additionalProperties": false
  }
}
