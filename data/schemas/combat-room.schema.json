{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "combat-room",
  "type": "object",
  "required": [
    "line",
    "sessionSeconds",
    "arena",
    "player",
    "combo",
    "techniques",
    "block",
    "parry",
    "dodge",
    "stance",
    "break",
    "pattern",
    "feel"
  ],
  "properties": {
    "line": {
      "enum": [
        "green",
        "amber",
        "red",
        "black"
      ]
    },
    "combo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "anim",
          "damage",
          "startup",
          "active",
          "recovery",
          "reach",
          "arc"
        ]
      }
    }
  }
}
