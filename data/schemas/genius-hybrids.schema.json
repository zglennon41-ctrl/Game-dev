{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "genius-hybrids",
  "type": "object",
  "required": [
    "rule",
    "pairs"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "rule": {
      "type": "object",
      "required": [
        "margin",
        "min",
        "bend",
        "kind",
        "path",
        "carried"
      ],
      "additionalProperties": false,
      "properties": {
        "margin": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "bend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "carried": {
          "type": "string"
        }
      }
    },
    "pairs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+\\+[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
